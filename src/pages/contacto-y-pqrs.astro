---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../lib/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contacto y PQRS | ${site.name}`,
  url: `${site.url}/contacto-y-pqrs/`,
};
---

<Layout
  title="Contacto y PQRS | Lawyer Company Abogados"
  description="Escríbenos, agenda tu cita o radica una PQRS (petición, queja, reclamo o sugerencia). Teléfono, WhatsApp, correo y oficina en Rionegro, Antioquia."
  schema={schema}
>
  <PageHeader
    eyebrow="Contacto"
    title="Contacto y PQRS"
    description="Escríbenos por el canal que prefieras. Si tu mensaje es una petición, queja, reclamo o sugerencia (PQRS), también puedes radicarla aquí y te confirmaremos su recepción."
  />

  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-5 md:px-8 md:py-20">
    <div class="md:col-span-2">
      <h2 class="font-display text-2xl font-semibold text-ink-900">Canales de contacto</h2>
      <ul class="mt-6 space-y-6">
        <li class="flex gap-3">
          <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-tuscany-500" aria-hidden="true"><path d="M4 4a2 2 0 00-2 2v1.161l8 4.8 8-4.8V6a2 2 0 00-2-2H4zm16 4.239-8 4.8-8-4.8V14a2 2 0 002 2h12a2 2 0 002-2V8.239z"/></svg>
          <div>
            <p class="font-semibold text-ink-800">Correo electrónico</p>
            <a href={`mailto:${site.email}`} class="text-sm text-tuscany-600 hover:underline">{site.email}</a>
          </div>
        </li>
        <li class="flex gap-3">
          <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-tuscany-500" aria-hidden="true"><path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-.897 1.68l-.983.42a.75.75 0 00-.39.94c.63 1.813 2.09 3.273 3.903 3.903a.75.75 0 00.94-.39l.42-.983a1.5 1.5 0 011.68-.897l3.223.716A1.5 1.5 0 0116.5 15.352V16.5a1.5 1.5 0 01-1.5 1.5H13.5C6.596 18 2 13.404 2 6.5V3.5z" clip-rule="evenodd"/></svg>
          <div>
            <p class="font-semibold text-ink-800">Teléfono / WhatsApp</p>
            <a href={`tel:${site.phoneHref}`} class="text-sm text-tuscany-600 hover:underline">{site.phoneDisplay}</a>
            <p class="mt-1 text-xs text-ink-400">{site.hoursNote}</p>
          </div>
        </li>
        <li class="flex gap-3">
          <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-tuscany-500" aria-hidden="true"><path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.31 13.31 0 002.273 1.765 11.19 11.19 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd"/></svg>
          <div>
            <p class="font-semibold text-ink-800">Oficina</p>
            <p class="text-sm text-ink-500">{site.address}</p>
          </div>
        </li>
      </ul>

      <div id="pagos" class="mt-10 scroll-mt-28 rounded-xl border border-tuscany-100 bg-tuscany-50 p-6">
        <h3 class="font-display text-lg font-semibold text-ink-900">Realiza tus pagos</h3>
        <p class="mt-2 text-sm text-ink-500">
          Puedes realizar el pago de tu asesoría o proceso por transferencia a la siguiente cuenta:
        </p>
        <p class="mt-2 text-sm font-mono text-ink-700">Cuenta: {site.bankAccount}</p>
        <p class="mt-1 text-xs text-ink-400">
          Valor de la asesoría inicial: {site.consultationFee}. Si tu proceso ya está en curso,
          confirma el valor exacto con tu abogado a cargo antes de transferir.
        </p>
      </div>

      <div class="mt-6 rounded-xl border border-tuscany-100 bg-white p-6">
        <h3 class="font-display text-lg font-semibold text-ink-900">¿Qué es una PQRS?</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-500">
          PQRS significa <strong>Petición, Queja, Reclamo o Sugerencia</strong>. Es el canal formal
          para pedir información sobre tu proceso, manifestar una inconformidad con el servicio
          recibido, reclamar por un error o compromiso incumplido, o sugerirnos cómo mejorar.
          Puedes radicar tu PQRS con el formulario de esta página, seleccionando el asunto
          correspondiente en tu mensaje.
        </p>
      </div>
    </div>

    <div class="md:col-span-3">
      <form id="contact-form" class="rounded-2xl border border-tuscany-100 bg-white p-6 shadow-sm md:p-8">
        <h2 class="font-display text-2xl font-semibold text-ink-900">Escríbenos</h2>
        <p class="mt-1 text-sm text-ink-500">Te responderemos por el medio que elijas.</p>

        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label for="name" class="text-sm font-medium text-ink-700">Nombre completo</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="mt-1.5 w-full rounded-md border border-ink-200 px-3.5 py-2.5 text-sm text-ink-800 placeholder:text-ink-300 focus:border-tuscany-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tuscany-200"
              placeholder="Tu nombre y apellido"
            />
          </div>

          <div>
            <label for="email" class="text-sm font-medium text-ink-700">Correo electrónico</label>
            <input
              id="email"
              name="email"
              type="email"
              inputmode="email"
              spellcheck="false"
              required
              autocomplete="email"
              class="mt-1.5 w-full rounded-md border border-ink-200 px-3.5 py-2.5 text-sm text-ink-800 placeholder:text-ink-300 focus:border-tuscany-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tuscany-200"
              placeholder="tucorreo@ejemplo.com"
            />
          </div>

          <div>
            <label for="phone" class="text-sm font-medium text-ink-700">Número telefónico</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              class="mt-1.5 w-full rounded-md border border-ink-200 px-3.5 py-2.5 text-sm text-ink-800 placeholder:text-ink-300 focus:border-tuscany-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tuscany-200"
              placeholder="+57 300 000 0000"
            />
          </div>

          <div class="sm:col-span-2">
            <span class="text-sm font-medium text-ink-700">Método preferido de contacto</span>
            <div class="mt-2 flex gap-6">
              <label class="flex items-center gap-2 text-sm text-ink-600">
                <input type="radio" name="preferred-contact" value="Correo electrónico" checked class="h-4 w-4 border-ink-300 text-tuscany-600 focus:ring-tuscany-500" />
                Correo electrónico
              </label>
              <label class="flex items-center gap-2 text-sm text-ink-600">
                <input type="radio" name="preferred-contact" value="Teléfono" class="h-4 w-4 border-ink-300 text-tuscany-600 focus:ring-tuscany-500" />
                Teléfono
              </label>
            </div>
          </div>

          <div class="sm:col-span-2">
            <label for="message" class="text-sm font-medium text-ink-700">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="mt-1.5 w-full rounded-md border border-ink-200 px-3.5 py-2.5 text-sm text-ink-800 placeholder:text-ink-300 focus:border-tuscany-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-tuscany-200"
              placeholder="Cuéntanos brevemente tu situación o el motivo de tu PQRS"
            ></textarea>
          </div>

          <div class="sm:col-span-2">
            <label class="flex items-start gap-2.5 text-sm text-ink-600">
              <input
                type="checkbox"
                name="privacy"
                required
                class="mt-0.5 h-4 w-4 rounded border-ink-300 text-tuscany-600 focus:ring-tuscany-500"
              />
              <span>
                Acepto la <a href="/politica-de-privacidad/" class="font-medium text-tuscany-600 hover:underline">Política de privacidad</a> y el tratamiento de mis datos personales para efectos de esta solicitud.
              </span>
            </label>
          </div>
        </div>

        <button
          type="submit"
          class="mt-6 w-full rounded-md bg-tuscany-500 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-tuscany-400 sm:w-auto"
        >
          Enviar mensaje
        </button>
        <p id="form-note" class="mt-3 text-xs text-ink-400" role="status"></p>
      </form>
    </div>
  </section>
</Layout>

<script define:vars={{ email: site.email }}>
  function setup() {
    const form = document.getElementById('contact-form');
    const note = document.getElementById('form-note');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = data.get('name');
      const preferred = data.get('preferred-contact');
      const phone = data.get('phone');
      const message = data.get('message');

      const subject = encodeURIComponent(`Contacto / PQRS desde el sitio web — ${name}`);
      const body = encodeURIComponent(
        `Nombre: ${name}\nCorreo: ${data.get('email')}\nTeléfono: ${phone || 'No indicado'}\nMétodo preferido: ${preferred}\n\nMensaje:\n${message}`
      );

      window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
      if (note) {
        note.textContent = 'Se abrirá tu cliente de correo con el mensaje ya redactado. Si prefieres, escríbenos directo por WhatsApp.';
      }
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
