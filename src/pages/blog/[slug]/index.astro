---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatter = new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: site.legalName },
  publisher: { '@type': 'Organization', name: site.legalName },
  mainEntityOfPage: `${site.url}/blog/${post.id}/`,
};
---

<Layout title={`${post.data.title} | Blog Lawyer Company`} description={post.data.description} schema={schema}>
  <article class="mx-auto max-w-3xl px-4 py-16 md:px-8 md:py-20">
    <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-wider text-tuscany-600">
      <span class="rounded-full bg-tuscany-100 px-2.5 py-1">{post.data.category}</span>
      <time datetime={post.data.pubDate.toISOString()} class="text-ink-400">
        {formatter.format(post.data.pubDate)}
      </time>
    </div>
    <h1 class="mt-4 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">{post.data.title}</h1>
    <p class="mt-4 text-lg text-ink-500">{post.data.description}</p>

    <div class="prose mt-10 max-w-none prose-headings:font-display prose-a:text-tuscany-600 prose-a:no-underline hover:prose-a:underline">
      <Content />
    </div>

    <div class="mt-12 border-t border-tuscany-100 pt-8">
      <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-tuscany-600 hover:text-tuscany-700">
        ← Volver al blog
      </a>
    </div>
  </article>
</Layout>
