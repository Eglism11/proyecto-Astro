---
import { practiceAreas, site } from '../lib/site';
import ScaleIn from '@astroanimate/core/ScaleIn';
import ArrowCTAButton from '@astroanimate/core/ArrowCTAButton';
import Button from './Button.astro';
import CarouselNav from './CarouselNav.astro';

interface Props {
  areas?: typeof practiceAreas;
  showLinkToAll?: boolean;
  compact?: boolean;
  carousel?: boolean;
}

const { areas = practiceAreas, showLinkToAll = false, compact = false, carousel = false } = Astro.props;
---

<div {...(carousel ? { 'data-carousel': true } : {})}>
<div
  {...(carousel ? { 'data-carousel-track': true } : {})}
  class={
    carousel
      ? '-mx-4 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3'
      : 'grid gap-5 sm:grid-cols-2 lg:grid-cols-3'
  }
>
  {areas.map((area, index) => (
    <ScaleIn
      enhance
      initialScale={0.94}
      delay={(index % 6) * 70}
      margin="0px 0px -60px 0px"
      class={carousel ? 'w-[78%] shrink-0 snap-center sm:w-auto sm:shrink' : undefined}
    >
      <article
        id={compact ? undefined : area.slug}
        class="scroll-mt-28 flex h-full flex-col rounded-xl border border-tuscany-100 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
      >
        <h3 class="font-display text-lg font-semibold text-ink-900">{area.title}</h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">
          {compact ? area.summary : area.description}
        </p>
        {compact ? (
          <div class="mt-4 flex flex-col gap-2">
            <Button href={`/asesoria-juridica-integral/#${area.slug}`} variant="primary" class="w-full text-center">
              Ver más
            </Button>
            <Button
              href={`${site.whatsapp}?text=${encodeURIComponent(`Hola, quiero asesoría en ${area.title}.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              variant="secondary"
              class="w-full text-center"
            >
              Asesórate
            </Button>
          </div>
        ) : (
          <a
            href={`${site.whatsapp}?text=${encodeURIComponent(`Hola, quiero asesoría en ${area.title}.`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-tuscany-600 hover:text-tuscany-700"
          >
            Asesórate con expertos
            <svg viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 011.06 0l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 010-1.06z" clip-rule="evenodd"/></svg>
          </a>
        )}
      </article>
    </ScaleIn>
  ))}
</div>
{carousel && <CarouselNav />}
</div>

{showLinkToAll && (
  <div class="mt-8 text-center">
    <ArrowCTAButton as="a" href="/asesoria-juridica-integral/" label="Ver las 18 áreas de práctica" class="!text-tuscany-600 justify-center" />
  </div>
)}
