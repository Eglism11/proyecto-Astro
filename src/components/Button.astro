---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline-light';
  class?: string;
  target?: string;
  rel?: string;
}

const { href, variant = 'primary', class: className = '', target, rel } = Astro.props;

const variants = {
  primary:
    'bg-tuscany-500 text-white hover:bg-tuscany-400 shadow-sm',
  secondary:
    'bg-white text-tuscany-700 hover:bg-tuscany-50 border border-tuscany-200',
  'outline-light':
    'border border-white/70 text-white hover:bg-white/10',
};
---

<a
  href={href}
  target={target}
  rel={rel}
  class={`inline-flex items-center justify-center gap-2 rounded-md px-6 py-3 text-sm font-semibold transition-all duration-150 hover:-translate-y-0.5 hover:shadow-md active:scale-95 active:shadow-sm active:duration-75 ${variants[variant]} ${className}`}
>
  <slot />
</a>
