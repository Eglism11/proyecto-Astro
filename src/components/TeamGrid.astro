---
import { Image } from 'astro:assets';
import { team, site, type TeamMember } from '../lib/site';
import ScaleIn from '@astroanimate/core/ScaleIn';
import ArrowCTAButton from '@astroanimate/core/ArrowCTAButton';
import CarouselNav from './CarouselNav.astro';

interface Props {
  members?: TeamMember[];
  carousel?: boolean;
  /** Index (0-based) from which members only render at the tablet
   * breakpoint (sm–lg): hidden on mobile, visible on tablet, hidden
   * again on desktop. Used to fill a 2-column tablet row without
   * padding out the mobile carousel or the desktop 3-column grid. */
  tabletOnlyFrom?: number;
}

const { members = team, carousel = false, tabletOnlyFrom } = Astro.props;

const images = import.meta.glob<import('astro').ImageMetadata>(
  '../assets/images/team/*.jpg',
  { eager: true, import: 'default' }
);

function getImage(key?: string) {
  if (!key) return null;
  const match = Object.entries(images).find(([path]) => path.includes(`/${key}.jpg`));
  return match?.[1] ?? null;
}

function initials(name: string) {
  return name
    .split(' ')
    .filter((_, i, arr) => i === 0 || i === arr.length - 1)
    .map((part) => part[0])
    .join('');
}

function slugify(name: string) {
  return name
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-');
}

function splitName(name: string) {
  const [first, ...rest] = name.split(' ');
  return { first, last: rest.join(' ') };
}
---

<div {...(carousel ? { 'data-carousel': true } : {})}>
<div
  {...(carousel ? { 'data-carousel-track': true } : {})}
  class={
    carousel
      ? '-mx-4 flex snap-x snap-mandatory gap-6 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3'
      : 'grid gap-6 sm:grid-cols-2 lg:grid-cols-3'
  }
>
  {members.map((member, index) => {
    const photo = getImage(member.image);
    const dialogId = `team-${slugify(member.name)}`;
    const tabletOnly = tabletOnlyFrom !== undefined && index >= tabletOnlyFrom;
    return (
      <ScaleIn
        enhance
        initialScale={0.94}
        delay={(index % 6) * 70}
        margin="0px 0px -60px 0px"
        class={[carousel && 'w-[78%] shrink-0 snap-center sm:w-auto sm:shrink', tabletOnly && 'hidden sm:block lg:hidden']
          .filter(Boolean)
          .join(' ') || undefined}
      >
        <article class="group flex h-full flex-col overflow-hidden rounded-xl border border-tuscany-100 bg-white shadow-sm">
          <div class="overflow-hidden">
            {photo ? (
              <Image
                src={photo}
                alt={`${member.name}, ${member.role} en Lawyer Company`}
                width={480}
                height={480}
                class="h-56 w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <div class="flex h-56 w-full items-center justify-center bg-tuscany-100">
                <span class="font-display text-4xl font-semibold text-tuscany-500">{initials(member.name)}</span>
              </div>
            )}
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="font-display text-lg font-semibold text-ink-900">{member.name}</h3>
            <p class="mt-0.5 text-sm font-medium text-tuscany-600">{member.role}</p>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{member.bio}</p>
            <div data-team-trigger={dialogId} class="mt-4">
              <ArrowCTAButton as="button" label="Conócelo" class="!text-tuscany-600" />
            </div>
          </div>
        </article>

        <dialog id={dialogId} data-team-dialog class="team-dialog w-full max-w-3xl rounded-2xl bg-transparent p-0 backdrop:bg-ink-950/70">
          <div class="relative grid overflow-hidden rounded-2xl bg-ink-50 md:max-h-[min(80vh,640px)] md:grid-cols-[280px_1fr]">
            <div class="h-56 shrink-0 md:h-full">
              {photo ? (
                <Image
                  src={photo}
                  alt={`${member.name}, ${member.role} en Lawyer Company`}
                  width={560}
                  height={720}
                  class="h-full w-full object-cover object-top"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-tuscany-100">
                  <span class="font-display text-5xl font-semibold text-tuscany-500">{initials(member.name)}</span>
                </div>
              )}
            </div>

            <div class="relative overflow-y-auto p-6 sm:p-10">
              <svg
                class="pointer-events-none absolute right-0 top-0 h-48 w-48 text-tuscany-200/60"
                viewBox="0 0 200 200"
                fill="none"
                aria-hidden="true"
              >
                <g stroke="currentColor" stroke-width="1.5">
                  <path d="M150 0 C 100 40, 220 90, 150 140 S 60 210, 120 240" />
                  <path d="M170 -10 C 120 40, 230 100, 160 150 S 80 220, 130 250" />
                  <path d="M190 -20 C 140 40, 245 110, 175 165 S 100 235, 145 260" />
                </g>
              </svg>

              <button
                type="button"
                data-team-close
                aria-label="Cerrar"
                class="absolute right-4 top-4 z-10 rounded-full bg-white/80 p-1.5 text-ink-600 shadow-sm transition-colors hover:bg-white hover:text-ink-900"
              >
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/></svg>
              </button>

              <div class="relative pr-10">
                <h3 class="font-display text-3xl font-semibold leading-tight text-tuscany-600 sm:text-4xl">
                  {splitName(member.name).first}
                </h3>
                {splitName(member.name).last && (
                  <p class="font-display text-base uppercase tracking-wide text-ink-800">
                    {splitName(member.name).last}
                  </p>
                )}

                <div class="mt-5 flex items-center gap-3">
                  <span class="h-6 w-1 rounded-full bg-tuscany-500" />
                  <span class="text-sm font-semibold text-ink-800">{member.role}</span>
                </div>

                <div class="mt-5 flex items-center gap-4 text-xs font-semibold uppercase tracking-wider text-ink-400">
                  <a href={member.linkedin ?? site.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-tuscany-600">
                    LinkedIn
                  </a>
                  <span aria-hidden="true">|</span>
                  <a
                    href={`${site.whatsapp}?text=${encodeURIComponent(`Hola, quiero asesoría con ${member.name.split(' ')[0]}.`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-tuscany-600"
                  >
                    Asesoría
                  </a>
                </div>

                <p class="relative mt-6 text-sm leading-relaxed text-ink-600">
                  {member.bio}
                </p>
              </div>
            </div>
          </div>
        </dialog>
      </ScaleIn>
    );
  })}
</div>
{carousel && <CarouselNav />}
</div>

<style>
  dialog.team-dialog {
    /* Tailwind's preflight resets margin to 0 on every element, which
       breaks the native <dialog> centering (it relies on margin: auto). */
    margin: auto;
    max-height: 90vh;
    overflow-y: auto;
  }

  dialog.team-dialog::backdrop {
    animation: team-dialog-fade 0.2s ease-out;
  }

  @keyframes team-dialog-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    dialog.team-dialog::backdrop {
      animation: none;
    }
  }
</style>

<script>
  function setup() {
    document.querySelectorAll('[data-team-trigger]').forEach((trigger) => {
      if (trigger.hasAttribute('data-bound')) return;
      trigger.setAttribute('data-bound', 'true');

      const targetId = trigger.getAttribute('data-team-trigger');
      const dialog = targetId ? document.getElementById(targetId) : null;
      if (!dialog || !(dialog instanceof HTMLDialogElement)) return;

      trigger.addEventListener('click', () => dialog.showModal());

      dialog.querySelector('[data-team-close]')?.addEventListener('click', () => dialog.close());

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  }

  // `astro:page-load` isn't guaranteed to have fired yet by the time this
  // script runs (e.g. on the very first hard navigation), so bind
  // immediately too. The `data-bound` guard above keeps both paths safe.
  setup();
  document.addEventListener('astro:page-load', setup);
</script>
