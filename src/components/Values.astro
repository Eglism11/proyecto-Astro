---
import ScaleIn from '@astroanimate/core/ScaleIn';
import CarouselNav from './CarouselNav.astro';

const values = [
  {
    name: 'Empatía',
    description: 'Comprendemos las necesidades y preocupaciones de cada cliente, más allá del expediente.',
  },
  {
    name: 'Responsabilidad',
    description: 'Integridad, transparencia y cumplimiento de los estándares éticos y legales en cada actuación.',
  },
  {
    name: 'Respaldo',
    description: 'Apoyo sólido y confiable en cada paso del proceso legal, sin dejarte solo en el camino.',
  },
  {
    name: 'Honestidad',
    description: 'La comunicación abierta es un pilar de nuestra práctica: te decimos lo que necesitas saber.',
  },
  {
    name: 'Justicia',
    description: 'Trabajamos para promover la equidad y el acceso igualitario a la justicia.',
  },
];
---

<div data-carousel>
  <div data-carousel-track class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-5">
    {values.map((value, index) => (
      <ScaleIn
        enhance
        initialScale={0.94}
        delay={index * 70}
        margin="0px 0px -60px 0px"
        class="w-[70%] shrink-0 snap-center sm:w-auto sm:shrink"
      >
        <div class="flex h-full flex-col rounded-xl border border-tuscany-100 bg-white p-6">
          <h3 class="font-display text-lg font-semibold text-tuscany-600">{value.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">{value.description}</p>
        </div>
      </ScaleIn>
    ))}
  </div>
  <CarouselNav />
</div>
