---
// Prev/next controls for a horizontal scroll-snap carousel. Pair with a
// wrapping element carrying `data-carousel` and a scroll track carrying
// `data-carousel-track` (see CarouselScript.astro for the wiring).
---

<div class="mt-3 flex justify-end gap-2 sm:hidden">
  <button
    type="button"
    data-carousel-prev
    aria-label="Ver anterior"
    class="flex h-9 w-9 items-center justify-center rounded-full border border-tuscany-200 bg-white text-ink-600 shadow-sm transition-all duration-150 hover:scale-110 hover:bg-tuscany-50 hover:shadow-md active:scale-95 disabled:pointer-events-none disabled:opacity-30 disabled:hover:scale-100"
  >
    <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 010 1.06L7.06 10l4.72 4.72a.75.75 0 11-1.06 1.06l-5.25-5.25a.75.75 0 010-1.06l5.25-5.25a.75.75 0 011.06 0z" clip-rule="evenodd"/></svg>
  </button>
  <button
    type="button"
    data-carousel-next
    aria-label="Ver siguiente"
    class="flex h-9 w-9 items-center justify-center rounded-full border border-tuscany-200 bg-white text-ink-600 shadow-sm transition-all duration-150 hover:scale-110 hover:bg-tuscany-50 hover:shadow-md active:scale-95 disabled:pointer-events-none disabled:opacity-30 disabled:hover:scale-100"
  >
    <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 011.06 0l5.25 5.25a.75.75 0 010 1.06l-5.25 5.25a.75.75 0 01-1.06-1.06L12.94 10 8.22 6.28a.75.75 0 010-1.06z" clip-rule="evenodd"/></svg>
  </button>
</div>
