---
import FadeInText from '@astroanimate/core/FadeInText';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-ink-800 bg-ink-900 py-16 md:py-20">
  <FadeInText as="div" duration={0.6} class="mx-auto max-w-4xl px-4 text-center md:px-8">
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-wider text-tuscany-300">{eyebrow}</p>
    )}
    <h1 class="mt-2 font-display text-4xl font-semibold text-white sm:text-5xl">{title}</h1>
    {description && <p class="mx-auto mt-4 max-w-2xl text-ink-200">{description}</p>}
  </FadeInText>
</section>
