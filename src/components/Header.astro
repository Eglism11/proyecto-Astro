---
import Logo from './Logo.astro';
import { nav, site } from '../lib/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-ink-700/60 bg-ink-900" transition:animate="none">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 md:px-8">
    <Logo />

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {nav.map((item) => {
          const active = currentPath === item.href;
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class={`text-sm font-medium transition-colors hover:text-tuscany-300 ${
                  active ? 'text-tuscany-300' : 'text-ink-100'
                }`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <div class="relative" data-portal-menu>
        <button
          type="button"
          data-portal-trigger
          aria-expanded="false"
          aria-haspopup="true"
          class="flex items-center gap-1.5 rounded-md bg-tuscany-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-tuscany-600"
        >
          Ingresar a la plataforma
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          data-portal-panel
          class="absolute right-0 top-full mt-2 hidden w-56 overflow-hidden rounded-lg border border-ink-200 bg-white py-1 shadow-xl"
        >
          <a
            href={site.platformUrlAbogado}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2.5 text-sm text-ink-700 hover:bg-tuscany-50"
          >
            Eres abogado
          </a>
          <a
            href={site.platformUrlCliente}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2.5 text-sm text-ink-700 hover:bg-tuscany-50"
          >
            Eres cliente
          </a>
        </div>
      </div>

      <a
        href={`${site.whatsapp}?text=${encodeURIComponent('Hola, quiero programar una cita.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-tuscany-500 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-tuscany-400"
      >
        Programa tu cita
      </a>
    </div>

    <button
      type="button"
      data-mobile-trigger
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
      class="rounded-md p-2 text-white lg:hidden"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" data-mobile-panel class="hidden border-t border-ink-700/60 bg-ink-900 lg:hidden">
    <nav aria-label="Móvil" class="flex flex-col gap-1 px-4 py-4">
      {nav.map((item) => (
        <a href={item.href} class="rounded-md px-3 py-2.5 text-sm font-medium text-ink-100 hover:bg-ink-800 hover:text-tuscany-300">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex flex-col gap-3 px-4 pb-5">
      <a
        href={`${site.whatsapp}?text=${encodeURIComponent('Hola, quiero programar una cita.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-tuscany-500 px-4 py-2.5 text-center text-sm font-semibold text-white"
      >
        Programa tu cita
      </a>
      <div class="grid grid-cols-2 gap-3">
        <a
          href={site.platformUrlAbogado}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md border border-ink-600 px-4 py-2.5 text-center text-sm font-semibold text-ink-100"
        >
          Eres abogado
        </a>
        <a
          href={site.platformUrlCliente}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md border border-ink-600 px-4 py-2.5 text-center text-sm font-semibold text-ink-100"
        >
          Eres cliente
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setup() {
    const portalTrigger = document.querySelector('[data-portal-trigger]');
    const portalPanel = document.querySelector('[data-portal-panel]');

    portalTrigger?.addEventListener('click', () => {
      const isOpen = portalPanel?.classList.toggle('hidden') === false;
      portalTrigger.setAttribute('aria-expanded', String(isOpen));
    });

    const mobileTrigger = document.querySelector('[data-mobile-trigger]');
    const mobilePanel = document.querySelector('[data-mobile-panel]');
    mobileTrigger?.addEventListener('click', () => {
      const isOpen = mobilePanel?.classList.toggle('hidden') === false;
      mobileTrigger.setAttribute('aria-expanded', String(isOpen));
    });
  }

  // Re-run after every navigation (initial load + each View Transitions swap).
  document.addEventListener('astro:page-load', setup);

  // Registered once: queries the live DOM on every click, so it stays correct
  // across client-side navigations without leaking duplicate listeners.
  document.addEventListener('click', (event) => {
    const portalMenu = document.querySelector('[data-portal-menu]');
    const portalPanel = portalMenu?.querySelector('[data-portal-panel]');
    const portalTrigger = portalMenu?.querySelector('[data-portal-trigger]');
    if (portalMenu && portalPanel && !portalPanel.classList.contains('hidden') && !portalMenu.contains(event.target as Node)) {
      portalPanel.classList.add('hidden');
      portalTrigger?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
