---
import { Image } from 'astro:assets';
import oficina from '../assets/images/site/oficina-recepcion.jpg';
import Button from './Button.astro';
import { site } from '../lib/site';
import FadeInText from '@astroanimate/core/FadeInText';
---

<section class="relative isolate overflow-hidden bg-ink-900">
  <Image
    src={oficina}
    alt="Recepción de las oficinas de Lawyer Company Abogados en Rionegro"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-[75%_30%] opacity-60"
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950 via-ink-950/85 to-ink-950/40"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-transparent to-transparent"></div>

  <div class="mx-auto max-w-7xl px-4 pb-16 pt-14 md:px-8 md:pb-24 md:pt-20">
    <div class="max-w-2xl">
      <FadeInText as="p" duration={0.6} blur="4px" class="mb-4 inline-flex items-center rounded-full border border-tuscany-400/40 bg-white/5 px-4 py-1.5 text-xs font-semibold tracking-wide text-tuscany-200 backdrop-blur-sm">
        Abogados en Rionegro, Antioquia · Cobertura en toda Colombia
      </FadeInText>
      <FadeInText as="h1" duration={0.7} delay={0.1} yOffset={16} class="font-display text-4xl font-semibold leading-[1.08] text-white sm:text-5xl lg:text-6xl">
        Formación y experiencia
      </FadeInText>
      <FadeInText as="p" duration={0.7} delay={0.22} class="mt-6 max-w-xl text-lg leading-relaxed text-ink-100">
        Nuestro equipo cuenta con sólida formación académica y reconocida experiencia en la
        práctica judicial, la asesoría empresarial y la estrategia legal — al servicio de personas
        y empresas en toda Colombia.
      </FadeInText>

      <FadeInText as="div" duration={0.7} delay={0.34} class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
        <Button
          href={`${site.whatsapp}?text=${encodeURIComponent('Hola, quiero programar una cita.')}`}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
          class="w-full sm:w-auto"
        >
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path fill-rule="evenodd" d="M5.75 2A1.75 1.75 0 004 3.75v.5c0 8.694 7.056 15.75 15.75 15.75h.5A1.75 1.75 0 0022 18.25v-1.9a1.75 1.75 0 00-1.415-1.717l-3.31-.662a1.75 1.75 0 00-1.734.51l-.943.943a12.045 12.045 0 01-5.516-5.516l.943-.943a1.75 1.75 0 00.51-1.734l-.662-3.31A1.75 1.75 0 007.65 2h-1.9z" clip-rule="evenodd"/></svg>
          Programa tu cita
        </Button>
        <Button href="/contacto-y-pqrs/#pagos" variant="outline-light" class="w-full sm:w-auto">
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4zM18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1z"/></svg>
          Realiza tus pagos
        </Button>
      </FadeInText>

      <FadeInText as="dl" duration={0.7} delay={0.46} class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-white/10 pt-8">
        <div>
          <dt class="font-display text-3xl font-semibold text-white">15+</dt>
          <dd class="mt-1 text-xs text-ink-200">Años de experiencia</dd>
        </div>
        <div>
          <dt class="font-display text-3xl font-semibold text-white">11</dt>
          <dd class="mt-1 text-xs text-ink-200">Abogados especialistas</dd>
        </div>
        <div>
          <dt class="font-display text-3xl font-semibold text-white">18</dt>
          <dd class="mt-1 text-xs text-ink-200">Áreas del derecho</dd>
        </div>
      </FadeInText>
    </div>
  </div>
</section>
